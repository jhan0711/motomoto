# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Variables de entorno.
# NUNCA deben subirse al repositorio: contienen claves de Supabase y de mapas.
# Se ignoran todos los .env salvo la plantilla de ejemplo, que no lleva valores.
.env
.env.*
!.env.example

# Credenciales de servicios
google-services.json
GoogleService-Info.plist

# Panel administrativo (Fase 20). Salidas de compilacion de Next.js.
# Su node_modules y sus .env ya quedan cubiertos por las reglas de mas arriba,
# que no llevan barra inicial y por eso valen en cualquier nivel.
admin/.next/
admin/out/
admin/next-env.d.ts

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Clave de servicio de FCM (Fase 19). ESTA SI ES SECRETA, a diferencia de
# google-services.json: permite enviar notificaciones en nombre del proyecto de
# Firebase, asi que quien la tenga puede escribirle a todos los usuarios de la
# aplicacion. Se sube a Expo desde su panel y no hace falta en el repositorio.
fcm-service-account.json
*-firebase-adminsdk-*.json

# Salida del sitio estatico (Fase 25)
site/dist/
